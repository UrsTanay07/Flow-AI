{
  "name": "flowai-traffic",
  "private": true,
  "version": "1.0.0",
  "description": "Accountable traffic intelligence and city operations workspace for Indian metros.",
  "type": "module",
  "scripts": {
    "dev": "node --experimental-strip-types server/dev.ts",
    "build": "vite build --configLoader runner",
    "start": "node --experimental-strip-types server/index.ts",
    "preview": "vite preview",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "typecheck": "tsc --noEmit",
    "lint": "npm run typecheck",
    "test": "node --experimental-strip-types --test server/**/*.test.ts",
    "test:coverage": "node --experimental-strip-types --experimental-test-coverage --test server/**/*.test.ts",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "check": "npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "express": "^4.22.2"
  },
  "devDependencies": {
    "@base-ui/react": "^1.7.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource/anton": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@gsap/react": "^2.1.2",
    "@react-three/fiber": "^9.7.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "gsap": "^3.15.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.37.0",
    "motion": "^13.1.1",
    "ogl": "^1.0.11",
    "postprocessing": "^6.39.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-icons": "^5.7.0",
    "react-leaflet": "^5.0.0",
    "recharts": "^3.10.1",
    "shadcn": "^4.19.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "three": "^0.185.1",
    "tw-animate-css": "^1.4.0",
    "vite": "^8.2.2",
    "@types/express": "^4.17.21",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.4.0",
    "autoprefixer": "^10.5.4",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.23.13",
    "typescript": "~7.0.2"
  },
  "engines": {
    "node": ">=22.6"
  }
}
